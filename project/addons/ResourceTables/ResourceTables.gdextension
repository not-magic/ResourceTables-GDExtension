[configuration]

entry_symbol = "resource_tables_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "./bin/libResourceTables.macos.template_debug.dylib"
macos.release = "./bin/libResourceTables.macos.template_release.dylib"
windows.debug.x86_64 = "./bin/ResourceTables.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/ResourceTables.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/libResourceTables.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libResourceTables.linux.template_release.x86_64.so"
