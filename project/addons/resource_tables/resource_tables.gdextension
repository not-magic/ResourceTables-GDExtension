[configuration]

entry_symbol = "resource_tables_library_init"
compatibility_minimum = "4.5"
reloadable = true

include_tags = ["editor"]

[libraries]

macos.editor = "./bin/libResourceTables.macos.editor.universal.dylib"
windows.editor.x86_64 = "./bin/ResourceTables.windows.editor.x86_64.dll"
linux.editor.x86_64 = "./bin/libResourceTables.linux.editor.x86_64.so"
